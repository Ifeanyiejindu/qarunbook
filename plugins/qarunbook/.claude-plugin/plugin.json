{
  "name": "qarunbook",
  "displayName": "qarunbook",
  "description": "A QA runbook your coding assistant can read and write. Testers raise what breaks; the assistant reads what failed, fixes it, and marks the issue resolved.",
  "version": "1.1.0",
  "author": { "name": "Ifeanyi Ejindu", "url": "https://qarunbook.com" },
  "homepage": "https://qarunbook.com/guides/claude-code-qa-skill",
  "repository": "https://github.com/Ifeanyiejindu/qarunbook",
  "license": "MIT",
  "keywords": ["qa", "testing", "test-plan", "runbook", "uat", "mcp"],
  "mcpServers": {
    "qa-runbook": {
      "type": "http",
      "url": "${QARUNBOOK_URL:-https://qarunbook.com/api/mcp}",
      "headers": { "Authorization": "Bearer ${QARUNBOOK_TOKEN}" }
    }
  }
}
